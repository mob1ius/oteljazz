# Python
.venv/
__pycache__/
*.pyc

# Logic Pro project -- large binary, not meaningfully diffable, personal working file.
otelljazztesting.logicx/

# Raw archival audio masters -- the trimmed deliverables in supplementary_audio/ and
# zenodo_deposit/ ARE tracked; these are the untrimmed source bounces they were cut from.
renders/

# Raw corpus source (re-download via docs/README.md's setup command if needed; the mined
# derivative, engine/corpus_model_jazz.json, is what the engine actually uses and IS tracked).
corpus_raw/

# Local OTel-hooks capture state (real Claude Code session telemetry, for the real-trace roadmap
# item -- see docs/BUILD_NOTES.md). Stays local, never committed, never leaves this machine
# unless explicitly exported/shared.
.otel-hook-data/

# Personal/local Claude Code settings -- machine-specific permission overrides, not project config.
.claude/settings.local.json

# Internal dev log and pre-submission strategy notes -- candid reasoning (bug post-mortems,
# acceptance-strategy/venue-shopping notes, review calibration) never meant to ship publicly.
# Kept locally (backed up outside the repo too) so CLAUDE.md's "read BUILD_NOTES.md every
# session" instruction still works; just no longer committed. See CLAUDE.md's pre-public
# checklist for why these two specifically were pulled before the repo went public.
docs/BUILD_NOTES.md
paper/working-notes.md

# ScholarOne submission artifacts -- generated from the .md/figures sources for the actual
# journal upload, renamed to Cambridge's required convention. Not canonical (the tracked .md
# and paper/figures/*.eps are), so kept local-only, regenerate from those if lost.
paper/OSWagner.docx
paper/WagnerF*.eps

# Per-venue submission build directories -- LaTeX builds, downloaded templates, page renders,
# and a personal print copy. Not canonical (the tracked .md and paper/figures/*.eps are); the
# real submission content lives in the actual venue's portal once uploaded. cmj-submission and
# leonardo-submission are abandoned-venue scratch work from before JAES was settled on.
paper/jaes-submission/
paper/cmj-submission/
paper/leonardo-submission/
paper/personal-latex/

.DS_Store

# Built site output (assembled from an explicit allowlist by scripts/build_site.sh; Cloudflare
# Pages builds this itself on deploy, so the artifact never needs committing).
dist/

# Local wrangler/miniflare state (local D1 emulation for testing functions/_middleware.js).
.wrangler/
