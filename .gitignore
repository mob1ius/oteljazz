# Python
.venv/
__pycache__/
*.pyc

# Logic Pro project -- large binary, not meaningfully diffable.
otelljazztesting.logicx/

# Raw archival audio masters -- the trimmed deliverables in supplementary_audio/ and
# zenodo_deposit/ ARE tracked; these are the untrimmed source bounces they were cut from.
renders/

# Raw corpus source (re-download via docs/README.md's setup command if needed; the mined
# derivative, engine/corpus_model_jazz.json, is what the engine actually uses and IS tracked).
corpus_raw/

# Local OTel capture state -- real Claude Code session telemetry from .claude/hooks/capture.py.
# Stays local; never committed.
.otel-hook-data/

# Machine-specific Claude Code settings -- local permission overrides, not project config.
.claude/settings.local.json

# Working notes and drafts. Local-only; not part of the published record.
docs/BUILD_NOTES.md
docs/LAUNCH_BRIEF.md
docs/ROADMAP.md
paper/working-notes.md
paper/review_organised_sound_*.md

# Journal submission builds -- LaTeX output, downloaded templates, and page renders, generated
# from the tracked .md sources and paper/figures/*.eps. Not canonical; regenerate if lost.
paper/*.docx
paper/WagnerF*.eps
paper/jaes-submission/
paper/cmj-submission/
paper/leonardo-submission/
paper/personal-latex/

.DS_Store

# Built site output (assembled from an explicit allowlist by scripts/build_site.sh; Cloudflare
# builds this itself on deploy, so the artifact never needs committing).
dist/

# Local wrangler/miniflare state.
.wrangler/
