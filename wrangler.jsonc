{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oteljazz",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",

  // dist/ is produced by `bash scripts/build_site.sh` from an explicit allowlist -- never point
  // this at the repo root, which holds ~430MB that must not ship (see the build script).
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",

    // Which requests reach the Worker at all. Without this the asset server answers directly and
    // the Worker never runs, so nothing would be logged -- silently.
    //
    // "/*" then excludes the heavy static paths, because a single page view pulls ~40 sample
    // files and running (and being billed for) the Worker on each would multiply invocations by
    // roughly 45x for no data: those requests are filtered out of logging anyway. What remains is
    // exactly the interesting set -- "/", robots.txt, ai.txt, and any unknown probe path such as
    // /wp-admin or /.env, which are among the more revealing things a crawler does.
    //
    // The four app files used to be excluded here too, and were added back deliberately: a
    // request for /app.js is the only thing that separates a browser that actually ran the page
    // from a crawler that fetched the HTML and left, and without it every per-visitor question
    // starts from a population that is mostly crawlers. That costs four extra invocations on a
    // first visit (they are cached afterwards), against ~40 for the samples that stay excluded.
    // See src/index.js's ASSET_RE, which has the matching exemption -- removing one without the
    // other silently logs nothing new.
    //
    // Negative patterns take precedence over positive ones and order does not matter.
    "run_worker_first": [
      "/*",
      "!/samples/*",
      "!/assets/*",
      "!/vendor/*"
    ]
  },

  // The crawler log. See infra/d1_schema.sql for the table and the reasoning about what is
  // deliberately not stored (no IP addresses).
  //
  // database_id is set. The id is not a secret -- it only names the database, and using it still
  // requires account credentials -- so it lives in the repo rather than in dashboard config,
  // which keeps the binding reviewable and means a fresh clone deploys correctly.
  //
  // Apply the schema once per database, from the repo root, before expecting any rows:
  //   npx wrangler d1 execute oteljazz-logs --remote --file=infra/d1_schema.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oteljazz-logs",
      "database_id": "c3406719-10f2-4ecb-bb06-17c6ab4c8a87"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Live-OTLP relay (v1.3.0, docs/ROADMAP.md). One Durable Object instance per session id
  // (src/index.js derives it via idFromName), each an isolated room: real spans POSTed to
  // /live/<session>/v1/traces broadcast only to browser tabs connected to
  // wss://oteljazz.com/live/<session>/ws for that same session id. See src/live-relay.js for
  // what this version does and does not do yet.
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_RELAY", "class_name": "LiveRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveRelay"] }
  ]
}
